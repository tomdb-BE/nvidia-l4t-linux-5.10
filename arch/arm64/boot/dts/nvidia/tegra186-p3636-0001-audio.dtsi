			cpu {
				sound-dai = <&tegra_admaif ADMAIF12>;
			};
			codec {
				sound-dai = <&tegra_axbar XBAR_ADMAIF12>;
			};
		};

		admaif13_pcm_link: nvidia-audio-card,dai-link@12 {
			status = "okay";

			cpu {
