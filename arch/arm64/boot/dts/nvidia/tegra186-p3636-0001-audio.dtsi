/* Enable the audio fabric required by the machine card above. */
&aconnect {
	status = "okay";
};

&adma {
	status = "okay";
};

&tegra_ahub {
	status = "okay";
};

&tegra_admaif {
	status = "okay";
};

&tegra_i2s1 { status = "okay"; };
&tegra_i2s2 { status = "okay"; };
&tegra_i2s3 { status = "okay"; };
&tegra_i2s4 { status = "okay"; };
&tegra_i2s5 { status = "okay"; };
&tegra_i2s6 { status = "okay"; };

&tegra_dmic1 { status = "okay"; };
&tegra_dmic2 { status = "okay"; };
&tegra_dmic3 { status = "okay"; };
&tegra_dmic4 { status = "okay"; };

&tegra_dspk1 { status = "okay"; };
&tegra_dspk2 { status = "okay"; };

&tegra_adsp_audio {
	status = "okay";
	compr-ops = <1>;
	num-plugin = <6>;

	plugin-info-1 {
		plugin-name = "mp3-dec1";
		firmware-name = "nvmp3dec.elf";
		widget-name = "MP3-DEC1";
	};
	plugin-info-2 {
		plugin-name = "spkprot";
		firmware-name = "nvspkprot.elf";
		widget-name = "SPKPROT-SW";
	};
	plugin-info-3 {
		plugin-name = "src";
		firmware-name = "nvsrc.elf";
		widget-name = "SRC";
	};
	plugin-info-4 {
		plugin-name = "aac-dec1";
		firmware-name = "nvaacdec.elf";
		widget-name = "AAC-DEC1";
	};
	plugin-info-5 {
		plugin-name = "aec";
		firmware-name = "nvoice.elf";
		widget-name = "AEC";
	};
	plugin-info-6 {
		plugin-name = "wire";
		firmware-name = "libnvwirefx.elf";
		widget-name = "WIRE";
	};
};
